# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Data (large / third-party licensed — reproducible via scripts/prepare_dataset.py)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated outputs (mock outputs are never committed; live outputs are opt-in)
outputs/*
!outputs/.gitkeep
!outputs/README.md

# Logs
logs/
*.log

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
