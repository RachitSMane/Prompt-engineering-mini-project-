# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored — never commit real API keys.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# One of: ollama | gemini | openai | anthropic | groq | mock
#   ollama  -> LOCAL and free, no API key (default). Needs the Ollama app running.
#   groq / gemini / openai / anthropic -> optional cloud providers; need the matching
#              API key below and the provider's package (see requirements.txt).
#   mock    -> OFFLINE development mode. Deterministic rule-based fixtures.
#              NOT a language model; results are NEVER experimental evidence.
LLM_PROVIDER=ollama

# Model name for the chosen provider. Check the provider's docs for current names.
#   gemini:    gemini-3.5-flash  (gemini-2.5-flash is no longer available to new API keys)
#   openai:    gpt-4o-mini
#   anthropic: claude-haiku-4-5
#   groq:      openai/gpt-oss-120b   (llama-3.3-70b-versatile has been retired)
#   ollama:    qwen2.5:3b
LLM_MODEL=qwen2.5:3b

# Deterministic settings for reproducible experiments
LLM_TEMPERATURE=0
# Output cap per call. 1024 is 2.5-10x a normal extraction and stops a small local model that starts
# looping (repeating list items) from running into the timeout; looping output is truncated and repaired.
# Product summaries / judge verdicts are larger: the reported D3 run used 2048 (set in the environment).
LLM_MAX_OUTPUT_TOKENS=1024
# Local models on a laptop can be slow (300 s); cloud providers are fine with 60.
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=3

# Client-side rate limit for CLOUD providers only (local Ollama calls bypass it)
LLM_REQUESTS_PER_MINUTE=10

# LLM-as-a-Judge: a different model family from the extractor, so it doesn't grade its own output.
# (If left empty: ollama/llama3.2 when LLM_PROVIDER=ollama, otherwise the extraction model.)
JUDGE_PROVIDER=ollama
JUDGE_MODEL=llama3.2

# --- Local Ollama ------------------------------------------------------------
# 127.0.0.1 rather than localhost: on Windows, localhost may try IPv6 first.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Context window; must fit the few-shot prompt (~2.8K tokens) plus the output.
OLLAMA_NUM_CTX=8192
# Non-local Ollama endpoints are rejected unless explicitly allowed.
OLLAMA_ALLOW_REMOTE=false

# --- API keys: optional cloud providers only (leave empty for local Ollama) --
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Pipeline ---------------------------------------------------------------
# Number of LLM repair attempts after the first malformed/invalid response
MAX_REPAIR_ATTEMPTS=2
# Require aspect evidence to be a (near-)verbatim quote from the review
STRICT_EVIDENCE_GROUNDING=true

# --- Mock mode (development only) -------------------------------------------
# Percentage of mock extraction responses that are deliberately corrupted so the
# repair pipeline can be exercised offline.
MOCK_MALFORMED_RATE=15

# --- Dataset ----------------------------------------------------------------
DATASET_CATEGORY=Appliances
DATASET_NUM_PRODUCTS=15
DATASET_REVIEWS_PER_PRODUCT=100
ANNOTATION_SAMPLE_SIZE=300
RANDOM_SEED=42
