# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored — never commit real API keys.
# ---------------------------------------------------------------------------

# --- LLM provider -----------------------------------------------------------
# One of: gemini | openai | anthropic | groq | ollama | mock
#   gemini  -> needs GOOGLE_API_KEY (free key: https://aistudio.google.com/apikey)
#   mock    -> OFFLINE development mode. Deterministic rule-based fixtures.
#              NOT a language model; results are NEVER experimental evidence.
LLM_PROVIDER=gemini

# Model name for the chosen provider. Check the provider's docs for current names.
#   gemini:    gemini-2.5-flash
#   openai:    gpt-4o-mini
#   anthropic: claude-haiku-4-5
#   groq:      llama-3.3-70b-versatile
#   ollama:    llama3.1
LLM_MODEL=gemini-2.5-flash

# Deterministic settings for reproducible experiments
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Client-side rate limit (Gemini free tier is roughly 10 requests/minute for flash models)
LLM_REQUESTS_PER_MINUTE=10

# Optional: use a different model as the LLM-as-a-Judge (defaults to LLM_PROVIDER/LLM_MODEL)
JUDGE_PROVIDER=
JUDGE_MODEL=

# --- API keys (only the one for your provider is needed) --------------------
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Pipeline ---------------------------------------------------------------
# Number of LLM repair attempts after the first malformed/invalid response
MAX_REPAIR_ATTEMPTS=2
# Require aspect evidence to be a (near-)verbatim quote from the review
STRICT_EVIDENCE_GROUNDING=true

# --- Mock mode (development only) -------------------------------------------
# Percentage of mock extraction responses that are deliberately corrupted so the
# repair pipeline can be exercised offline.
MOCK_MALFORMED_RATE=15

# --- Dataset ----------------------------------------------------------------
DATASET_CATEGORY=Appliances
DATASET_NUM_PRODUCTS=15
DATASET_REVIEWS_PER_PRODUCT=100
ANNOTATION_SAMPLE_SIZE=300
RANDOM_SEED=42
